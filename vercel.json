{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/price-watch/poll",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    { "source": "/google2d416f47472822c8.html", "destination": "/google2d416f47472822c8.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
