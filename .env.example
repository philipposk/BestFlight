# ── Server-side (Vercel project env vars) ──────────────────────────────────
DUFFEL_TOKEN=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
CLIMATIQ_TOKEN=
GEMINI_API_KEY=

# Firebase Admin service account JSON (entire JSON, one line, base64 or escaped)
FIREBASE_ADMIN_SA_JSON=

# Cron secret — Vercel injects CRON_SECRET for cron jobs; or set your own
CRON_SECRET=

# ── Client-side (Vite VITE_ prefix; exposed to browser) ────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
VITE_UNSPLASH_ACCESS_KEY=
